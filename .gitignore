# Global/Root patterns
.env
.env.local
.env.*
!.env.example
.idea/
.vscode/
*.log
.DS_Store
judge0.conf
!.example

# Backend (Spring Boot / Maven) ignores
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/!**/src/main/**/target/
backend/!**/src/test/**/target/
backend/.apt_generated
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings
backend/.springBeans
backend/.sts4-cache
backend/*.iws
backend/*.iml
backend/*.ipr
backend/out/
backend/build/
backend/!**/src/main/**/build/
backend/!**/src/test/**/build/

# Frontend (Vite / React / Node) ignores
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/.eslintcache
frontend/scratch/