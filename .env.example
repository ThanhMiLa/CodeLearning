# ===== Database Configuration =====
POSTGRES_DB=CodeLearning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Backend Database Connection URL
DB_URL=jdbc:postgresql://localhost:5432/CodeLearning
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# ===== Redis Configuration =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ===== RabbitMQ Configuration =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ===== Security Configuration (JWT) =====
# Secure HMAC-SHA signer key (Min 256 bits, base64 encoded recommended)
JWT_SIGNER_KEY=your_secure_jwt_signer_key_here

# ===== Application & Webhook URLs =====
# Set this to your public IP or ngrok tunnel URL so external services (PayOS, Judge0) can send callbacks
WEBHOOK_BASE_URL=http://localhost:8080/codelearning

# ===== PayOS Integration Keys =====
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# ===== Cloudinary Integration Keys =====
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
